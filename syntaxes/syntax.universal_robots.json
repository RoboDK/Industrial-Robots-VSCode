{
    "name": "universal_robots",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#control"
        },
        {
            "include": "#movement"
        },
        {
            "include": "#built-in-var"
        },
        {
            "include": "#built-in-var1"
        },
        {
            "include": "#built-in-fcn"
        },
        {
            "include": "#built-in-fcn1"
        }
    ],
    "repository": {
        "built-in-fcn": {
            "patterns": [
                {
                    "match": "(?i)\\b(set_tcp|set_payload|set_gravity|get_actual_joint_positions|get_actual_tcp_pose|get_target_joint_positions|get_target_tcp_pose|get_inverse_kin|get_forward_kin|pose_trans|pose_inv|pose_add|pose_sub|pose_dist|set_digital_out|get_digital_in|get_digital_out|set_analog_out|get_analog_in|set_tool_digital_out|get_tool_digital_in|set_tool_voltage|set_configurable_digital_out|get_configurable_digital_in|set_standard_digital_out|get_standard_digital_in|get_standard_digital_out|set_standard_analog_out|get_standard_analog_in|textmsg|str_cat|to_str|to_num|socket_open|socket_close|socket_send_string|socket_send_line|socket_send_int|socket_read_string|socket_read_ascii_float|socket_read_binary_integer|socket_set_var|socket_get_var|force_mode|end_force_mode|freedrive_mode|end_freedrive_mode|zero_ftsensor|get_tcp_force|rpc_factory|sin|cos|tan|asin|acos|atan|atan2|sqrt|pow|log|exp|floor|ceil|abs|norm|d2r|r2d)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn1": {
            "patterns": [
                {
                    "match": "(?i)\\b(speed_ms|speed_rads|accel_mss|accel_radss|blend_radius_m|blocking)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-var": {
            "patterns": [
                {
                    "match": "(?i)\\b(global|local|True|False|None)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "built-in-var1": {
            "patterns": [
                {
                    "match": "\\p\\[(-?\\d+\\.?\\d+?,?\\s?)+\\]",
                    "name": "constant.language"
                }
            ]
        },
        "comment": {
            "patterns": [
                {
                    "begin": "#",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "(?i)\\b(if|elif|else|end|def|sec|thread|while|return|run|kill|halt|break|continue|and|or|not)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "movement": {
            "patterns": [
                {
                    "match": "(?i)\\b(movej|movel|movec|movep|servoj|servoc|speedj|speedl|stopj|stopl|popup|sleep|sync)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\-?(?<![\\w.])\\d+(\\.\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string"
                }
            ]
        }
    },
    "scopeName": "robodk.universal_robots"
}