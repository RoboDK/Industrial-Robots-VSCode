{
    "name": "Kawasaki",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#fcn-call"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#joint-target"
        },
        {
            "include": "#control"
        },
        {
            "include": "#control1"
        },
        {
            "include": "#control-flow"
        },
        {
            "include": "#movement"
        },
        {
            "include": "#built-in-var"
        },
        {
            "include": "#built-in-fcn"
        },
        {
            "include": "#built-in-types"
        },
        {
            "include": "#built-in-types1"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "built-in-fcn": {
            "patterns": [
                {
                    "match": "(?i)\\b(BASE|JMOVE|LMOVE|CALL|ALWAYS|NEVER|FINE|MM/MIN|DEG/S|ON|OFF)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-types": {
            "patterns": [
                {
                    "match": "\\bMM\\/S",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-types1": {
            "patterns": [
                {
                    "match": "(?i)\\b(TYPE|TWAIT|SIGNAL|WAIT|SIG|TOOL|SWAIT|PULSE|DLYSIG|PRINT|PAUSE|HALT|STOP|RETURN|LWS|LWC|LWE|BREAK|HERE|POINT)\\b",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-var": {
            "patterns": [
                {
                    "match": "(?i)\\b(SPEED|ACCEL|ACCURACY|DECEL|WEIGHT)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "comment": {
            "patterns": [
                {
                    "begin": ";",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "\\.PROGRAM",
                    "name": "keyword.control"
                }
            ]
        },
        "control-flow": {
            "patterns": [
                {
                    "match": "(?i)\\b(UNTIL|VALUE|WHILE|CASE|ELSE|GOTO|STEP|THEN|AND|ANY|END|FOR|NOT|DO|IF|OF|OR|TO)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "control1": {
            "patterns": [
                {
                    "match": "\\.END",
                    "name": "keyword.control"
                }
            ]
        },
        "fcn-call": {
            "patterns": [
                {
                    "begin": "%",
                    "end": "%",
                    "name": "string"
                }
            ]
        },
        "joint-target": {
            "patterns": [
                {
                    "match": "#PPOINT\\b|#(?=\\[)",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "movement": {
            "patterns": [
                {
                    "match": "(?i)\\b(TRANS|C1MOVE|C2MOVE|HMOVE|JAPPRO|LAPPRO|JDEPART|LDEPART|DRAW|TDRAW|DRIVE|HOME|ALIGN|XMOVE)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "-?(?<![\\w.])\\d+(\\.\\d*)?([eE][+-]?\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "\\==|<>|<=|>=|[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string"
                }
            ]
        }
    },
    "scopeName": "robodk.kawasaki"
}