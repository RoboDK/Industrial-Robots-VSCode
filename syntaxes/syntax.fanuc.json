{
    "name": "Fanuc",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#fcn-call"
        },
        {
            "include": "#config-string"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#control"
        },
        {
            "include": "#control1"
        },
        {
            "include": "#control2"
        },
        {
            "include": "#control3"
        },
        {
            "include": "#control4"
        },
        {
            "include": "#control5"
        },
        {
            "include": "#control6"
        },
        {
            "include": "#control7"
        },
        {
            "include": "#control8"
        },
        {
            "include": "#control9"
        },
        {
            "include": "#control10"
        },
        {
            "include": "#movement"
        },
        {
            "include": "#movement1"
        },
        {
            "include": "#system-variable"
        },
        {
            "include": "#built-in-var"
        },
        {
            "include": "#built-in-var1"
        },
        {
            "include": "#built-in-fcn"
        },
        {
            "include": "#built-in-fcn1"
        },
        {
            "include": "#built-in-fcn2"
        },
        {
            "include": "#built-in-fcn3"
        },
        {
            "include": "#built-in-types"
        },
        {
            "include": "#acc"
        },
        {
            "include": "#built-in-types1"
        },
        {
            "include": "#built-in-types2"
        },
        {
            "include": "#built-in-types3"
        },
        {
            "include": "#built-in-types4"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "acc": {
            "patterns": [
                {
                    "match": "\\bACC\\d+",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-fcn": {
            "patterns": [
                {
                    "match": "\\bMESSAGE\\[[^\\]]*\\]",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn1": {
            "patterns": [
                {
                    "match": "\\bUTOOL\\[\\d+\\]",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn2": {
            "patterns": [
                {
                    "match": "\\bUFRAME\\[\\d+\\]",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn3": {
            "patterns": [
                {
                    "match": "(?i)\\b(GP1|MESSAGE|UFRAME|UTOOL|PAUSE|UFRAME_NUM|UTOOL_NUM|GP2|GP3|TIMER_START|PAYLOAD|COL|RSR|UOP)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-types": {
            "patterns": [
                {
                    "match": "\\bCNT\\d+",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-types1": {
            "patterns": [
                {
                    "match": "(?i)\\b(DATE|TIME|deg|mm|FINE|UF|UT|J1|J2|J3|J4|J5|J6|J7|J8|X|Y|Z|W|R|READ_WRITE|ON|OFF|E1|E2|E3|sec|msec|INC)\\b",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-types2": {
            "patterns": [
                {
                    "match": "\\b[LJ][\\s]P\\[\\d+\\]",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-types3": {
            "patterns": [
                {
                    "match": "\\bPR\\[\\d+,\\d+\\]",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-types4": {
            "patterns": [
                {
                    "match": "\\bPR?\\[\\d+\\]",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-var": {
            "patterns": [
                {
                    "match": "(?i)\\b(STACK_SIZE|TASK_PRIORITY|TIME_SLICE|BUSY_LAMP_OFF|ABORT_REQUEST|PAUSE_REQUEST|CONFIG)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "built-in-var1": {
            "patterns": [
                {
                    "match": "\\b(R|AR|SR|GI|GO|AI|AO|RI|RO|UI|UO|SI|SO|F|TIMER)\\[\\d+\\]",
                    "name": "constant.language"
                }
            ]
        },
        "comment": {
            "patterns": [
                {
                    "begin": "(?<!IF.*)!",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "config-string": {
            "patterns": [
                {
                    "match": "'[^'\\n]*'",
                    "name": "string"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "(?i)\\b(PROG_SIZE|CREATE|MODIFIED|FILE_NAME|VERSION|LINE_COUNT|MEMORY_SIZE|PROTECT|TCD|DEFAULT_GROUP|CONTROL_CODE|OWNER|COMMENT)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "control1": {
            "patterns": [
                {
                    "match": "\\bLBL\\[\\d+\\]",
                    "name": "keyword.control"
                }
            ]
        },
        "control10": {
            "patterns": [
                {
                    "match": "\\d+%",
                    "name": "keyword.control"
                }
            ]
        },
        "control2": {
            "patterns": [
                {
                    "match": "(?i)\\b(IF|THEN|ELSE|ENDIF|JMP|LBL|FOR|ENDFOR|SELECT|RUN|ABORT|AND|OR|NOT|TIMEOUT|CALL|END|SKIP|OFFSET|TOOL_OFFSET|UALM|OVERRIDE|ENDSELECT)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "control3": {
            "patterns": [
                {
                    "match": "\\s\\d+:",
                    "name": "keyword.control"
                }
            ]
        },
        "control4": {
            "patterns": [
                {
                    "match": "\\/PROG",
                    "name": "keyword.control"
                }
            ]
        },
        "control5": {
            "patterns": [
                {
                    "match": "\\/ATTR",
                    "name": "keyword.control"
                }
            ]
        },
        "control6": {
            "patterns": [
                {
                    "match": "\\/MN",
                    "name": "keyword.control"
                }
            ]
        },
        "control7": {
            "patterns": [
                {
                    "match": "\\/POS",
                    "name": "keyword.control"
                }
            ]
        },
        "control8": {
            "patterns": [
                {
                    "match": "\\/END",
                    "name": "keyword.control"
                }
            ]
        },
        "control9": {
            "patterns": [
                {
                    "match": "\\d+mm/sec",
                    "name": "keyword.control"
                }
            ]
        },
        "fcn-call": {
            "patterns": [
                {
                    "begin": "CALL",
                    "end": ";",
                    "name": "string"
                }
            ]
        },
        "movement": {
            "patterns": [
                {
                    "match": "\\bD[OI]\\[\\d+\\]",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "movement1": {
            "patterns": [
                {
                    "match": "(?i)\\b(MN|POS|WAIT|DI|END)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\-?\\d+\\.\\d+",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "\\<>|<=|>=|[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string"
                }
            ]
        },
        "system-variable": {
            "patterns": [
                {
                    "match": "\\$[A-Z_][A-Z0-9_.]*(\\[\\d+\\])?",
                    "name": "constant.language"
                }
            ]
        }
    },
    "scopeName": "robodk.fanuc"
}