{
    "name": "Toshiba",
    "scopeName": "robodk.toshiba",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#motion"
        },
        {
            "include": "#control"
        },
        {
            "include": "#types"
        },
        {
            "include": "#built-in"
        },
        {
            "include": "#constant"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "begin": "\\bREMARK\\b",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"|(?=\\n)",
                    "name": "string"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "-?(?<![\\w.])\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "motion": {
            "patterns": [
                {
                    "match": "\\b(MOVEA|MOVEC|MOVEI|MOVEJ|MOVES|MOVE)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "\\b(PROGRAM|GLOBAL|RETURN|ENDIF|PAUSE|WHILE|ELSE|GOTO|KILL|NEXT|STEP|STOP|TASK|THEN|WITH|DIM|END|FOR|DO|IF|TO)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(INTEGER|COORD|POINT|TRANS|LOAD|REAL)\\b",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in": {
            "patterns": [
                {
                    "match": "\\b(DISABLE|PAYLOAD|BCDOUT|CLOSE1|CONFIG|ENABLE|NOWAIT|ACCEL|DECEL|DELAY|INPUT|OPEN1|PRINT|RESET|SPEED|BASE|DOUT|HAND|PASS|TOOL|WAIT|DIN)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "constant": {
            "patterns": [
                {
                    "match": "\\b(FALSE|TRUE|OFF|ON)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "==|<>|<=|>=|[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        }
    }
}
