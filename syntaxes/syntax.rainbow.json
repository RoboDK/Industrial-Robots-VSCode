{
    "name": "Rainbow",
    "scopeName": "robodk.rainbow",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#system-variable"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#motion"
        },
        {
            "include": "#control"
        },
        {
            "include": "#keyword"
        },
        {
            "include": "#built-in"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "begin": "#",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"|(?=\\n)",
                    "name": "string"
                }
            ]
        },
        "system-variable": {
            "patterns": [
                {
                    "match": "\\b(SD|RB)_[A-Z_]+\\d*\\b|\\brb_\\w+",
                    "name": "constant.language"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "-?(?<![\\w.])\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "motion": {
            "patterns": [
                {
                    "match": "\\bmove\\s+(joint|linear|circle|pose)\\b|\\bmovecircle\\b|\\bmovejoint\\b|\\bmovelinear\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "\\b(return|script|begin|while|else|end|for|out|if)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "match": "\\b(threepoints|absolute|constant|intended|relative|point|sec)\\b",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in": {
            "patterns": [
                {
                    "match": "\\b(manual_digital_out|manual_analog_out|digital_out|analog_out|tool_out|alarm|print|sleep|halt|wait|set)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "==|!=|<=|>=|&&|\\|\\||[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        }
    }
}
