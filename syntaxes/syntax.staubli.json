{
    "name": "Staubli",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#xml-tag"
        },
        {
            "include": "#fcn-call"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#library-prefix"
        },
        {
            "include": "#control"
        },
        {
            "include": "#movement"
        },
        {
            "include": "#built-in-var"
        },
        {
            "include": "#val3-constants"
        },
        {
            "include": "#val3-types"
        },
        {
            "include": "#val3-functions"
        },
        {
            "include": "#val3-fields"
        },
        {
            "include": "#built-in-fcn"
        },
        {
            "include": "#built-in-fcn1"
        },
        {
            "include": "#built-in-fcn2"
        },
        {
            "include": "#built-in-fcn3"
        }
    ],
    "repository": {
        "built-in-fcn": {
            "patterns": [
                {
                    "match": "(?i)\\b(version|xmlns|xsi|name|access|CDATA|key|file|link|alias|path|popUpMsg|delay|WAIT|FOR|waitEndMove|TIMEOUT|stackSize|millimeterUnit)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn1": {
            "patterns": [
                {
                    "match": "\\bd[oi]\\d+\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn2": {
            "patterns": [
                {
                    "match": "\\b[a-zA-Z]+\\(\\)",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn3": {
            "patterns": [
                {
                    "match": "(?i)\\b(x|y|z|rx|ry|rz|shoulder|elbow|wrist|fatherId|type|size|j1|j2|j3|j4|j5|j6|accel|vel|decel|tmax|rmax|blend|leave|reach|ioLink)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-var": {
            "patterns": [
                {
                    "match": "(?i)\\b(xml|encoding|programs|program|code|Database|Datas|Data|Value|Project|Parameter|Parameters|Libraries|Library|nTraj|jJoint|pPoint|flange|mNomSpeed|true|false|on|off)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "comment": {
            "patterns": [
                {
                    "begin": "//",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "(?i)\\b(END|BEGIN|if|else|elseIf|endIf|while|endWhile|do|until|for|to|step|endFor|switch|case|break|default|endSwitch|return|call)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "fcn-call": {
            "patterns": [
                {
                    "begin": "%",
                    "end": "%",
                    "name": "string"
                }
            ]
        },
        "library-prefix": {
            "patterns": [
                {
                    "match": "\\b[a-zA-Z_]\\w*:(?=[a-zA-Z_])",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "movement": {
            "patterns": [
                {
                    "match": "(?i)\\b(movej|movel|movec|movejf|movelf|resetMotion|stopMove|restartMove|autoConnectMove)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "-?(?<![\\w.])\\d+(\\.\\d*)?([eE][+-]?\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string"
                }
            ]
        },
        "val3-constants": {
            "patterns": [
                {
                    "match": "\\b(lefty|righty|ssame|sfree|epositive|enegative|esame|efree|wpositive|wnegative|wsame|wfree|cartesian)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "val3-fields": {
            "patterns": [
                {
                    "match": "(?<=\\.)(trsf|config|tvel|rvel|tmax|rmax|accel|vel|decel|blend|leave|reach|shoulder|elbow|wrist|otool|ftool|gripper|stime|ctime)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "val3-functions": {
            "patterns": [
                {
                    "match": "\\b(getMonitorSpeed|setMonitorSpeed|taskCreateSync|disablePower|jointToPoint|pointToJoint|enablePower|taskSuspend|taskCreate|taskResume|taskStatus|isDefined|isInRange|isPowered|isSettled|roundDown|distance|position|setFrame|taskKill|toString|userPage|aioLink|compose|dioLink|getData|isEmpty|libLoad|libPath|libSave|roundUp|setData|aioGet|aioSet|append|delete|dioGet|dioSet|gotoxy|insert|logMsg|resize|appro|clock|close|herej|limit|putln|round|toNum|watch|bAnd|bNot|bXor|help|here|link|open|size|sqrt|wait|abs|bOr|cls|cos|get|max|min|put|sel|sin|tan)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "val3-types": {
            "patterns": [
                {
                    "match": "\\b(num|bool|string|dio|aio|sio|config|configRx|configRs|trsf|frame|tool|point|pointRx|pointRs|joint|jointRx|jointRs|mdesc)\\b(?=\\s+[A-Za-z_]|\\[|\")",
                    "name": "storage.type.c"
                }
            ]
        },
        "xml-tag": {
            "patterns": [
                {
                    "match": "</?[A-Za-z_][\\w:.-]*|/?>|<\\?xml|\\?>|<!\\[CDATA\\[|\\]\\]>",
                    "name": "entity.name.tag"
                }
            ]
        }
    },
    "scopeName": "robodk.staubli"
}