{
    "name": "QJAR",
    "scopeName": "robodk.qjar",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#io"
        },
        {
            "include": "#timeout"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#motion"
        },
        {
            "include": "#control"
        },
        {
            "include": "#built-in"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "begin": "#",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"|(?=\\n)",
                    "name": "string"
                }
            ]
        },
        "io": {
            "patterns": [
                {
                    "match": "\\b(DO|DI|AO|AI)\\d+\\b",
                    "name": "constant.language"
                }
            ]
        },
        "timeout": {
            "patterns": [
                {
                    "match": "\\bT(?==)",
                    "name": "storage.type.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "-?(?<![\\w.])\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "motion": {
            "patterns": [
                {
                    "match": "\\b(MC|MJ|ML|MP)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "\\b(ENDWHILE|ENDFOR|RETURN|ENDIF|WHILE|CALL|ELSE|FOR|IF)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "built-in": {
            "patterns": [
                {
                    "match": "\\b(ThrowInfo|Sleep|WAIT)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "==|!=|<=|>=|[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        }
    }
}
