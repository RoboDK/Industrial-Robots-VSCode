{
    "name": "GSK",
    "scopeName": "robodk.gsk",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#point"
        },
        {
            "include": "#io"
        },
        {
            "include": "#motion-parameter"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#motion"
        },
        {
            "include": "#control"
        },
        {
            "include": "#built-in"
        },
        {
            "include": "#constant"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "begin": "#",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"|(?=\\n)",
                    "name": "string"
                }
            ]
        },
        "point": {
            "patterns": [
                {
                    "match": "\\bP\\d+\\b",
                    "name": "storage.type.c"
                }
            ]
        },
        "io": {
            "patterns": [
                {
                    "match": "\\b(OT|IN|AO|AI)\\d+\\b",
                    "name": "constant.language"
                }
            ]
        },
        "motion-parameter": {
            "patterns": [
                {
                    "match": "\\b(VJ|V|Z|T|PL)(?=\\d)",
                    "name": "storage.type.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "-?(?<![\\w.])\\d+(\\.\\d+)?\\b|(?<=\\b[VZT])\\d+(\\.\\d+)?",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "motion": {
            "patterns": [
                {
                    "match": "\\b(MOVC|MOVJ|MOVL|MOVS)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "\\b(ENDWHILE|ELSEIF|ENDIF|WHILE|CALL|ELSE|JUMP|MAIN|END|LAB|RET|IF)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "built-in": {
            "patterns": [
                {
                    "match": "\\b(DELAY|PULSE|AOUT|DOUT|WAIT|ADD|AIN|DEC|DIN|DIV|INC|MUL|SET|SUB)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "constant": {
            "patterns": [
                {
                    "match": "\\b(OFF|ON)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        }
    }
}
