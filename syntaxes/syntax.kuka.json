{
    "name": "KUKA",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        },
        {
            "include": "#fcn-call"
        },
        {
            "include": "#binary-literal"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#numbers1"
        },
        {
            "include": "#label"
        },
        {
            "include": "#control"
        },
        {
            "include": "#movement"
        },
        {
            "include": "#movement1"
        },
        {
            "include": "#built-in-fcn"
        },
        {
            "include": "#built-in-fcn1"
        },
        {
            "include": "#built-in-fcn2"
        },
        {
            "include": "#built-in-types"
        },
        {
            "include": "#system-variable"
        },
        {
            "include": "#enum-value"
        },
        {
            "include": "#built-in-var"
        },
        {
            "include": "#built-in-var1"
        },
        {
            "include": "#motion-data"
        },
        {
            "include": "#operator"
        }
    ],
    "repository": {
        "binary-literal": {
            "patterns": [
                {
                    "match": "'[BH][0-9A-Fa-f]+'",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "built-in-fcn": {
            "patterns": [
                {
                    "match": "(?i)\\b(BAS|SET_KRLMSG|EXISTS_KRLMSG|CLEAR_KRLMSG|TRIGGER|DISTANCE|SET_KRLDLG|EXISTS_KRLDLG|StrClear|LOOP_MSG|LOOP_CONT)\\b",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn1": {
            "patterns": [
                {
                    "match": "\\$LOOP_MSG",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-fcn2": {
            "patterns": [
                {
                    "match": "\\$LOOP_CONT",
                    "name": "entity.name.function.c"
                }
            ]
        },
        "built-in-types": {
            "patterns": [
                {
                    "match": "(?i)\\b(DECL|GLOBAL|CONST|INT|REAL|BOOL|CHAR|PRIO|FRAME|POS|E6POS|AXIS|E6AXIS|FDAT|LDAT|PDAT|E3POS|E3AXIS|E6POINT|STATE_T|MODUS_T|LOAD|INERTIA|SPL_VEL)\\b",
                    "name": "storage.type.c"
                }
            ]
        },
        "built-in-var": {
            "patterns": [
                {
                    "match": "(?i)\\b(BASE_DATA|TOOL_DATA|ADVANCE|TOOL|BASE|AXIS_ACT|ACT_EX_AX|EX_AX_DATA|INITMOV|BWDSTART|INITMOV|VEL_PTP|ACC_PTP|ANOUT|OUT|IN|ANIN|ON|OFF|TRUE|FALSE|ACC|VEL|APO|C_DIS|C_PTP|TIMER_STOP|TIMER_FLAG|TIMER|VEL\\.CP|ACT_BASE|APO\\.CPTP|APO\\.CDIS|VEL\\.ORI1|VEL\\.ORI2|ACC\\.ORI1|ACC\\.ORI2)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "built-in-var1": {
            "patterns": [
                {
                    "match": "\\#(?i:EX_AX_DATA|TIMER_STOP|TIMER_FLAG|BASE_DATA|TOOL_DATA|ACT_EX_AX|AXIS_ACT|BWDSTART|ACT_BASE|APO\\.CPTP|APO\\.CDIS|VEL\\.ORI1|VEL\\.ORI2|ACC\\.ORI1|ACC\\.ORI2|ADVANCE|INITMOV|INITMOV|VEL_PTP|ACC_PTP|VEL\\.CP|ANOUT|FALSE|C_DIS|C_PTP|TIMER|TOOL|BASE|ANIN|TRUE|OUT|OFF|ACC|VEL|APO|IN|ON)\\b|\\$(?i:EX_AX_DATA|TIMER_STOP|TIMER_FLAG|BASE_DATA|TOOL_DATA|ACT_EX_AX|AXIS_ACT|BWDSTART|ACT_BASE|APO\\.CPTP|APO\\.CDIS|VEL\\.ORI1|VEL\\.ORI2|ACC\\.ORI1|ACC\\.ORI2|ADVANCE|INITMOV|INITMOV|VEL_PTP|ACC_PTP|VEL\\.CP|ANOUT|FALSE|C_DIS|C_PTP|TIMER|TOOL|BASE|ANIN|TRUE|OUT|OFF|ACC|VEL|APO|IN|ON)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "comment": {
            "patterns": [
                {
                    "begin": ";",
                    "end": "(?=\\n)",
                    "name": "comment"
                }
            ]
        },
        "control": {
            "patterns": [
                {
                    "match": "(?i)\\b(REPEAT|FOR|WHILE|LOOP|DEF|IF|THEN|ELSE|SWITCH|LOOP|UNTIL|ENDFOR|ENDWHILE|ENDLOOP|END|ENDIF|ENDSWITCH|ENDLOOP|DEF|INI|END|ENDFCT|ENDDAT|WAIT|GOTO|CASE|DEFAULT|DEFFCT|ENDFCT|SEC|DEFDAT|PUBLIC|ENDDAT|RETURN|EXIT|HALT|INTERRUPT|WHEN|DO|BRAKE|RESUME|ENABLE|DISABLE|X|Y|Z|A|B|C|E1|E2|E3|E4|E5|E6|A1|A2|A3|A4|A5|A6|SPLINE|ENDSPLINE|PTP_SPLINE|WITH|CONTINUE|AND|OR|NOT|EXOR|B_AND|B_OR|B_NOT|B_EXOR|TRIGGER|DELAY|ENDTRIGGER|TIME_BLOCK|ENDTIME_BLOCK|CONST_VEL|STRUC|ENUM|SIGNAL|IMPORT|IS|EXT|EXTFCT|CHANNEL|ANIN|ANOUT|PULSE|CWRITE|CREAD|COPEN|CCLOSE)\\b",
                    "name": "keyword.control"
                }
            ]
        },
        "enum-value": {
            "patterns": [
                {
                    "match": "#[A-Za-z_]\\w*",
                    "name": "constant.language"
                }
            ]
        },
        "fcn-call": {
            "patterns": [
                {
                    "begin": "\\bEXT\\b",
                    "end": "( )",
                    "name": "string"
                }
            ]
        },
        "label": {
            "patterns": [
                {
                    "match": "^\\s*[A-Za-z_]\\w*:(?![=:])",
                    "name": "keyword.control"
                }
            ]
        },
        "motion-data": {
            "patterns": [
                {
                    "match": "(?i)\\b(GEAR_JERK|IPO_FRAME|APO_DIST|APO_MODE|AXIS_ACC|AXIS_VEL|CIRC_TYP|EXAX_IGN|FDAT_ACT|JERK_FAC|LDAT_ACT|PDAT_ACT|TQ_STATE|APO_FAC|BASE_NO|ORI_TYP|TOOL_NO|POINT2|CONT)\\b",
                    "name": "constant.language"
                }
            ]
        },
        "movement": {
            "patterns": [
                {
                    "match": "(?i)\\b(PTP|LIN|CIRC|SPTP|SLIN|SPL|SCIRC|PTP_REL|LIN_REL|CIRC_REL|SPTP_REL|SLIN_REL|SCIRC_REL)\\b",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "movement1": {
            "patterns": [
                {
                    "match": "\\w+\\(\\)",
                    "name": "entity.name.function.preprocessor.c"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\&.+",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "numbers1": {
            "patterns": [
                {
                    "match": "\\-?(?<![\\w.])\\d+(\\.\\d+)?\\b",
                    "name": "constant.numeric.c"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": "\\==|<>|<=|>=|[-+*/=<>]",
                    "name": "keyword.operator"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string"
                }
            ]
        },
        "system-variable": {
            "patterns": [
                {
                    "match": "\\$[A-Za-z_][\\w.]*",
                    "name": "constant.language"
                }
            ]
        }
    },
    "scopeName": "robodk.kuka"
}