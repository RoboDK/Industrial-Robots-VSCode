{
  ".prg": [
    {"id": "Huashu", "patterns": ["^<(attr|pos|program)>\\s*$"]},
    {"id": "ABB", "patterns": ["^%%%\\s*$", "(?i)^\\s*(MODULE|ENDMODULE|PROC|ENDPROC)\\b"]},
    {"id": "Epson", "patterns": ["(?i)^\\s*Function\\s+\\w+\\s*$", "(?i)^\\s*Fend\\b"]},
    {"id": "Mitsubishi", "patterns": ["(?i)^\\d+ (Mov|Mvs|Mvr|Spd|Cnt|Dly|Ovrd|JOvrd|Base|Tool|HOpen|HClose)\\b", "^[JP][A-Za-z0-9_]*=\\([-+\\d]", "^\\s*(MJ|MP) -?\\d", "^\\s*GS \\w+\\s*$"]},
    {"id": "Yamaha", "patterns": ["^\\s*MOVE [PLC],", "^\\s*DRIVE\\(\\d", "^\\s*GOSUB \\*\\w+"]}
  ],
  ".pg": [
    {"id": "Kawasaki", "patterns": ["^\\s*(JMOVE|LMOVE|C1MOVE|C2MOVE|HMOVE|TWAIT|SWAIT|JAPPRO|LAPPRO|LDEPART)\\b"]},
    {"id": "Omron", "patterns": ["^\\s*(MOVES?|APPROS?|DEPARTS?|ATTACH|DETACH|SELECT ROBOT)\\b", "\\bMMPS\\b"]}
  ],
  ".script": [
    {"id": "Techman", "patterns": ["^\\s*(PTP|Line|Circle)\\(\"[JC][PA][PR]\"", "^main\\s*\\{"]},
    {"id": "python", "patterns": ["\\bcc_client\\.\\w+\\("]},
    {"id": "lua", "patterns": ["^\\s*function\\s+[\\w.:]+\\s*\\(.*\\)\\s*$"]}
  ],
  ".dat": [
    {"id": "Inovance", "patterns": ["^FileInfo\\s*$"]},
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".job": [
    {"id": "Robostar", "patterns": ["^\\[(DESC|PNT|JOB)\\]", "^(JMOV|LMOV|CMOV) P\\d+"]},
    {"id": "ini", "patterns": ["^\\[(Comment|Version|Info|Files)\\]\\s*$"]}
  ],
  ".txt": [
    {"id": "python", "patterns": ["^\\s*global speed_mms\\b", "# move_id = \\d+\\s*$"]},
    {"id": "NEWKer", "patterns": ["^G0? G53 VJ=", "^G53 T\\d+ G90", "^(MOVJ VJ|MOVL V|MOVC V)=", "^WAT ?[-+]X\\d"]},
    {"id": "Siasun_JOB", "patterns": ["^/JOBMES\\s*$", "^/JOBINST\\s*$"]},
    {"id": "Mecademic", "patterns": ["^(MoveJoints|MoveLin|MovePose)\\(-?\\d", "^Set(WRF|TRF|JointVel|CartLinVel|Blending)\\(-?\\d"]},
    {"id": "Toshiba", "patterns": ["^\\s*MOVE[SC]? (POINT\\(|\\{)-?\\d", "^\\s*REMARK "]},
    {"id": "Turin", "patterns": ["^Move[JLC]\\((-?[\\d.]+,){20}", "^(IOOut|DAOut)=\\(", "^Set(User|Tool)Param\\(\\d"]},
    {"id": "AllenBradley", "patterns": ["(?i)^\\s*(MAM|MSO|MAJ)\\(Axis_\\d", "(?i)^\\s*if \\(?Axis_\\d+_\\w+\\.PC\\b", "^\\(\\*\\*.*Logix5000"]},
    {"id": "Cloos", "patterns": ["^RESTART\\s*$", "^LIST 1=\\(", "^STCP \\("]}
  ],
  ".task": [
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".configuration": [
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".ins": [
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".prog": [
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".path": [
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".pro": [
    {"id": "Inovance", "patterns": ["^ProgramInfo\\s*$", "^\\s*Start;\\s*$"]},
    {"id": "xml", "patterns": ["^\\s*<\\?xml\\b", "^\\s*<[A-Za-z][\\w:.-]*[\\s/>]"]}
  ],
  ".flow": [
    {"id": "json", "patterns": ["^\\s*[\\[{]"]}
  ],
  ".vi": [
    {"id": "json", "patterns": ["^\\s*[\\[{]"]}
  ],
  ".NNN": [
    {"id": "Nachi", "patterns": ["^MOVEX [AM]", "^\\s*(CALLP|CHGCOORD|WAITI) "]},
    {"id": "Hyundai", "patterns": ["^S\\d+\\s+MOVE [JLCP],", "^Program File Format Version"]}
  ],
  ".cnc": [
    {"id": "Aerotech", "patterns": ["^(JOINTS|LINEAR|CIRCULAR) [A-Z]+ -?\\d", "^VELOCITY (ON|OFF)\\s*$"]}
  ],
  ".spf": [
    {"id": "Siemens", "patterns": ["^\\s*N\\d+ ", "^\\s*G\\d+\\b"]}
  ],
  ".jbi": [
    {"id": "Elite", "patterns": ["^(SETJOINT|SETPOSE) [PV]\\d{3}\\b", "^MOVE[JLC] .*Const[PV]=", "^// HEADER\\s*$"]}
  ],
  ".cfg": [
    {"id": "Chaifu", "patterns": ["^MOV(J|L|CM|CE)\\(-?\\d", "^## Program generated by RoboDK"]},
    {"id": "properties", "patterns": ["^\\s*[\\w.\\-]+\\s*[=:]", "^\\s*\\["]}
  ],
  ".prj": [
    {"id": "json", "patterns": ["^\\s*\\{\\s*$", "\"FileType\":\\s*\"RobotProjectConfigFile\""]}
  ],
  ".mod": [
    {"id": "ABB", "patterns": ["^%%%\\s*$", "(?i)^\\s*(MODULE|ENDMODULE|PROC|ENDPROC|GLOBAL\\s+(VAR|Proc))\\b"]},
    {"id": "xml", "patterns": ["^\\s*<"]}
  ],
  ".pac": [
    {"id": "Denso", "patterns": ["^'!TITLE", "(?i)^\\s*(PROGRAM\\s+\\w+|Sub\\s+Main|TAKEARM|DEFPOS|DEFJNT|Move\\s+[PLC],)"]},
    {"id": "javascript", "patterns": ["\\bFindProxyForURL\\b"]}
  ],
  ".ltx": [
    {"id": "Staubli", "patterns": ["<externList\\b", "staubli\\.com/robotics"]},
    {"id": "latex", "patterns": ["\\\\(documentclass|begin\\{)"]}
  ]
}
